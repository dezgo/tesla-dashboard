# ---- copy to .env and fill in. NEVER commit the real .env ----

# Timezone
TZ=Australia/Sydney

# The one published hostname: your Flask dashboard.
# Point this A-record at the server IP, DNS-only (no Cloudflare proxy) so
# Caddy's HTTP-01 challenge can complete.
# TeslaMate's UI and Grafana are NOT published — they're loopback + SSH tunnel.
DASH_HOST=tesla.appfoundry.cc

# Let's Encrypt account email (Caddy uses this for cert issuance)
ACME_EMAIL=derek@watsonblinds.com.au

# --- Postgres (TeslaMate owns the DB) ---
TM_DB_USER=teslamate
TM_DB_PASS=change-me-strong-db-password
TM_DB_NAME=teslamate

# --- Read-only role your Flask app connects with ---
FLASK_DB_PASS=change-me-different-readonly-password

# --- TeslaMate encryption key (encrypts the stored Tesla API tokens) ---
# generate: openssl rand -base64 32
TM_ENCRYPTION_KEY=change-me-random-32-bytes

# --- Grafana login ---
GRAFANA_USER=admin
GRAFANA_PASS=change-me-grafana-password

# --- Basic auth in front of TeslaMate + your dashboard ---
# user is plain text; hash is a bcrypt hash from:  docker run --rm caddy caddy hash-password --plaintext 'yourpass'
BASIC_AUTH_USER=derek
BASIC_AUTH_HASH=$2a$14$replace_this_with_a_real_bcrypt_hash
