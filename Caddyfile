	email {$ACME_EMAIL}
}

# Only ONE host is published. TeslaMate's own UI and Grafana are deliberately
# not exposed: they bind to 127.0.0.1 on the host (see docker-compose.yml) and
# you reach them over an SSH tunnel. See the README for the tunnel commands.
{$DASH_HOST} {
	# Tesla Fleet API public-key hosting (only needed if you send commands).
	# Drop your public key at ./well-known/appspecific/com.tesla.3p.public-key.pem
	# and it is served unauthenticated at the required path.
	handle /.well-known/appspecific/com.tesla.3p.public-key.pem {
		root * /srv/well-known
		file_server
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		reverse_proxy flask:8000
	}
}
