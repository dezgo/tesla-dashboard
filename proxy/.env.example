# ---- copy to proxy/.env and fill in. NEVER commit the real .env ----
# Env for the SHARED edge proxy. Every site's public hostname and any basic-auth
# credentials live here; the app stacks themselves never see them.

# Let's Encrypt account email (Caddy uses this for cert issuance)
ACME_EMAIL=derekgg@gmail.com

# --- site: tesla dashboard ---
# A-record must point at this server, DNS-only (grey cloud, NOT proxied) or
# Caddy's HTTP-01 challenge can never complete.
DASH_HOST=tesla.appfoundry.cc

# user is plain text; hash is a bcrypt hash from:
#   docker run --rm caddy caddy hash-password --plaintext 'yourpass'
# A literal $ in the hash is safe here — compose passes it through, but note
# that if you ever inline it in a shell command it will expand.
BASIC_AUTH_USER=derek
BASIC_AUTH_HASH=$2a$14$replace_this_with_a_real_bcrypt_hash
